<Project Sdk="Microsoft.NET.Sdk">

  <!-- Implementations of the Application interfaces: EF Core, Identity, e-mail (ADR-0005). -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Pins the transitive Microsoft.EntityFrameworkCore.Relational to match Design's 10.0.12,
         avoiding an MSB3277 conflict (Npgsql's provider allows >= 10.0.4). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlService.Application\ControlService.Application.csproj" />
    <ProjectReference Include="..\ControlService.Domain\ControlService.Domain.csproj" />
  </ItemGroup>

</Project>
