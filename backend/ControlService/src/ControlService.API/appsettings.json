{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenIdleHours": 8,
    "Issuer": "control-service",
    "Audience": "control-service",
    "PasswordMinLength": 8,
    "LockoutMaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "SignIn": { "PermitLimit": 20 },
    "Refresh": { "PermitLimit": 60 }
  }
}
