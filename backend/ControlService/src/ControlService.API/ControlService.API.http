@ControlService.API_HostAddress = https://localhost:7243

# OpenAPI document generated from the endpoints.
# The interactive reference is at {{ControlService.API_HostAddress}}/scalar
GET {{ControlService.API_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{ControlService.API_HostAddress}}/health

###

# Authentication. Replace the password placeholder with the value you stored in the user
# secrets as Admin:InitialPassword; never commit a real one. Paste the access token from the sign-in
# response into @accessToken below. The refresh token travels in an HttpOnly cookie scoped to the refresh route.
@accessToken = <paste the accessToken here>

POST {{ControlService.API_HostAddress}}/api/v1/auth/sign-in
Content-Type: application/json

{
  "login": "admin",
  "password": "<the Admin:InitialPassword>"
}

###

# Previous plan, still in the code (decision 21): the Admin must replace its initial password.
POST {{ControlService.API_HostAddress}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "password": "<a new password, at least 8 characters>",
  "passwordConfirmation": "<the same new password>"
}

###

GET {{ControlService.API_HostAddress}}/api/v1/me
Authorization: Bearer {{accessToken}}

###

POST {{ControlService.API_HostAddress}}/api/v1/auth/refresh

###

POST {{ControlService.API_HostAddress}}/api/v1/auth/sign-out
Authorization: Bearer {{accessToken}}

###

# Permission profiles. The id and the version come from a previous response: the version goes back in If-Match.
@profileId = <paste a profile id here>
@version = <paste the ETag here, with its quotes>

GET {{ControlService.API_HostAddress}}/api/v1/screens
Authorization: Bearer {{accessToken}}

###

GET {{ControlService.API_HostAddress}}/api/v1/permission-profiles
Authorization: Bearer {{accessToken}}

###

GET {{ControlService.API_HostAddress}}/api/v1/permission-profiles/{{profileId}}
Authorization: Bearer {{accessToken}}

###

POST {{ControlService.API_HostAddress}}/api/v1/permission-profiles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Vendedor",
  "description": "Equipe comercial",
  "levels": [
    { "screen": "comercial/clientes", "level": "editor" },
    { "screen": "financeiro/contas-a-receber", "level": "leitor" }
  ]
}

###

PUT {{ControlService.API_HostAddress}}/api/v1/permission-profiles/{{profileId}}
Authorization: Bearer {{accessToken}}
If-Match: {{version}}
Content-Type: application/json

{
  "name": "Vendedor",
  "description": "Equipe comercial",
  "levels": [
    { "screen": "comercial/clientes", "level": "gerenciador" }
  ]
}

###

DELETE {{ControlService.API_HostAddress}}/api/v1/permission-profiles/{{profileId}}
Authorization: Bearer {{accessToken}}
If-Match: {{version}}

###
